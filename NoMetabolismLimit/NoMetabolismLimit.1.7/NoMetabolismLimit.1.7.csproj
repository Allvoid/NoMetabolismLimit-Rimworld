<Project Sdk="Microsoft.NET.Sdk">
  <!-- RimWorld 1.7 (Waylith engine, .NET 10) build of the same sources as ..\NoMetabolismLimit (that one is the 1.6 build). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>NoMetabolismLimit</AssemblyName>
    <RootNamespace>NoMetabolismLimit</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DefineConstants>$(DefineConstants);RW17</DefineConstants>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <Deterministic>true</Deterministic>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\1.7\Assemblies\</OutputPath>
    <NoWarn>$(NoWarn);CS0618;CS0649;CS0169;CS0414;CS0162;CS8981</NoWarn>
    <!-- The Steam folder holds 1.7 (branch unstable); the game dlls sit next to RimWorld.exe. -->
    <RimWorld17 Condition="'$(RimWorld17)' == ''">W:\SteamLibrary\steamapps\common\RimWorld</RimWorld17>
    <!-- Harmony for 1.7: Workshop 2009463077, folder 1.7 (Harmony 3, .NET 10). -->
    <Harmony17 Condition="'$(Harmony17)' == ''">W:\SteamLibrary\steamapps\workshop\content\294100\2009463077\1.7\Assemblies</Harmony17>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\NoMetabolismLimit\**\*.cs" Exclude="..\NoMetabolismLimit\obj\**;..\NoMetabolismLimit\bin\**;..\NoMetabolismLimit\.vs\**" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(RimWorld17)\Assembly-CSharp.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>$(RimWorld17)\UnityStubs.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(Harmony17)\0Harmony.dll</HintPath><Private>False</Private></Reference>
  </ItemGroup>
</Project>
